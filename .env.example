# 复制本文件为 .env 并填入本机的真实路径

# Zotero 7 可执行文件路径（macOS 默认如下，Win/Linux 自行调整）
ZOTERO_PLUGIN_ZOTERO_BIN_PATH="/Applications/Zotero.app/Contents/MacOS/zotero"

# 用于开发的独立 Zotero 配置目录（建议新建一个 dev profile，避免污染主资料库）
ZOTERO_PLUGIN_PROFILE_PATH="/Users/bytedance/Library/Application Support/Zotero/Profiles/dev"

# 用于开发的 Zotero 数据目录
ZOTERO_PLUGIN_DATA_DIR="/Users/bytedance/ZoteroData-Dev"
